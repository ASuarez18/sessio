      "updated": 1789339687292,
      "created": 1789193271354,
      "link": null,
      "locked": false,
      "text": "An admin screen to create new admin users and manage the\nadmin list, instead of seeding them.\nSign-up must never be able to set a role, and an admin must not\nbe able to remove themselves.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An admin screen to create new admin users and manage the admin list, instead of seeding them.\nSign-up must never be able to set a role, and an admin must not be able to remove themselves.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
