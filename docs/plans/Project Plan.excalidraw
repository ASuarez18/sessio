      "updated": 1789339687293,
      "created": 1789193271351,
      "link": null,
      "locked": false,
      "text": "Use your hosted MongoDB Atlas database with Mongoose. SQL\ndatabases are not allowed.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use your hosted MongoDB Atlas database with Mongoose. SQL databases are not allowed.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "TLriJHdxt7GZKQEtsVmBE",
      "type": "text",
      "x": -2349.3821511801757,
      "y": 225.964780751631,
      "width": 1192.0459391276042,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "lQGeCK-mDNfAB250DH6g2",
      "index": "bM7",
      "roundness": null,
      "seed": 207413558,
      "version": 830,
      "versionNonce": 1273724373,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687293,
      "created": 1789193271354,
      "link": null,
      "locked": false,
      "text": "Users, events, and registrations all live in MongoDB. \n\nUse references and `populate` wherever one record needs data\nfrom another, for example listing the users registered for an event.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Users, events, and registrations all live in MongoDB. \n\nUse references and `populate` wherever one record needs data from another, for example listing the users registered for an event.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
