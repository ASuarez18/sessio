      "link": null,
      "locked": false,
      "text": "- Deploy on Vercel & host DB on Atlas",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Deploy on Vercel & host DB on Atlas",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "A7DJ40r-FyatNmOY_lLH5",
      "type": "text",
      "x": -2344.5722445973306,
      "y": 690.0320501495228,
      "width": 1290.4796142578125,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "DFx9Au-QM48t-25tMZmYo",
      "index": "bLzO",
      "roundness": null,
      "seed": 937037226,
      "version": 1388,
      "versionNonce": 30807701,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687292,
      "created": 1789193271355,
      "link": null,
      "locked": false,
      "text": "- Vercel has no fixed outbound IP address, so set Atlas Network Access\nto allow access from anywhere (`0.0.0.0/0`). \nIn return, the other layers are required: \n- Database user with `readWrite` on this project's database only\n- A long generated password\n- `MONGODB_URI` set only in Vercel's environment variables.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Vercel has no fixed outbound IP address, so set Atlas Network Access to allow access from anywhere (`0.0.0.0/0`). \nIn return, the other layers are required: \n- Database user with `readWrite` on this project's database only\n- A long generated password\n- `MONGODB_URI` set only in Vercel's environment variables.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "6AUrgJK4pVlp2IzClwlZP",
      "type": "text",
      "x": -2344.5722445973306,
      "y": 987.9638391238607,
      "width": 1296.359619140625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "DFx9Au-QM48t-25tMZmYo",
      "index": "bLzV",
      "roundness": null,
      "seed": 1423342070,
      "version": 1497,
      "versionNonce": 1059850555,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687292,
      "created": 1789193271355,
      "link": null,
      "locked": false,
      "text": "- Set `MONGODB_URI` in Vercel before the first deployment. The build\nfails without it.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Set `MONGODB_URI` in Vercel before the first deployment. The build fails without it.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5Y_WDDsg32R5VqLmFv1oe",
