      "version": 940,
      "versionNonce": 2099278235,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687295,
      "created": 1789193271350,
      "link": null,
      "locked": false,
      "text": "Registration rules",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Registration rules",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DrAUBraTTxJrwXIMvHjhw",
      "type": "text",
      "x": -2340.092653998292,
      "y": -1357.3296288368056,
      "width": 1483.0893855183926,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "s3vR7wQSEmWbgWVamwAxs",
      "index": "bOn",
      "roundness": null,
      "seed": 1615332586,
      "version": 799,
      "versionNonce": 948783509,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687295,
      "created": 1789193271350,
      "link": null,
      "locked": false,
      "text": "- Each event has its own maximum number of attendees, set by an admin and\nchangeable at any time.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Each event has its own maximum number of attendees, set by an admin and changeable at any time.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RGXxGyVVAKF8v9EnCD6GV",
      "type": "text",
      "x": -2342.427660712159,
      "y": -1226.2851960907662,
      "width": 1487.759398946127,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "s3vR7wQSEmWbgWVamwAxs",
      "index": "bOo",
      "roundness": null,
      "seed": 735483574,
      "version": 940,
      "versionNonce": 1492485691,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687295,
      "created": 1789193271350,
      "link": null,
      "locked": false,
      "text": "- When an event is full, the register button is disabled and the page says the event\nis full.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- When an event is full, the register button is disabled and the page says the event is full.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DWGQq7XzmZFD9QgjDJuiz",
      "type": "text",
      "x": -2334.2476682703455,
      "y": -1095.2407633447267,
      "width": 1471.3994140625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "s3vR7wQSEmWbgWVamwAxs",
      "index": "bOp",
      "roundness": null,
      "seed": 327931818,
      "version": 907,
      "versionNonce": 2142850805,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687295,
      "created": 1789193271351,
      "link": null,
      "locked": false,
      "text": "- The server must enforce the same rules on its own: reject a registration when\nthe event is full, and never allow the same user to register twice for the same\nevent. Do not rely on the disabled button alone.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The server must enforce the same rules on its own: reject a registration when the event is full, and never allow the same user to register twice for the same event. Do not rely on the disabled button alone.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
