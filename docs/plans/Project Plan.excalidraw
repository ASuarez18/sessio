      "x": -2340.112177425293,
      "y": 106.13171190397475,
      "width": 1205.109609060221,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "lQGeCK-mDNfAB250DH6g2",
