      "text": "src/\n├── app/\n│   ├── page.tsx\n│   │\n│   ├── events/\n│   │   ├── page.tsx\n│   │   └── [id]/\n│   │       └── page.tsx\n│   │\n│   ├── login/\n│   │   └── page.tsx\n│   │\n│   ├── register/\n│   │   └── page.tsx\n│   │\n│   ├── my-events/\n│   │   └── page.tsx\n│   │\n│   ├── admin/\n│   │   ├── page.tsx\n│   │   ├── events/\n│   │   │   ├── page.tsx\n│   │   │   ├── new/\n│   │   │   │   └── page.tsx\n│   │   │   └── [id]/\n│   │   │       └── edit/\n│   │   │           └── page.tsx\n│   │   │\n│   │   └── users/\n│   │       └── page.tsx\n│   │\n│   └── api/\n│       ├── auth/\n│       │   ├── register/route.ts\n│       │   ├── login/route.ts\n│       │   ├── logout/route.ts\n│       │   └── me/route.ts\n│       │\n│       ├── events/\n│       │   ├── route.ts\n│       │   └── [id]/\n│       │       ├── route.ts\n│       │       └── registrations/\n│       │           └── route.ts\n│       │\n│       ├── registrations/\n│       │   └── [eventId]/\n│       │       └── route.ts\n│       │\n│       └── users/\n│           └── route.ts\n│\n├── models/\n│   ├── User.ts\n│   ├── Event.ts\n│   └── Registration.ts\n│\n├── lib/\n│   ├── mongodb.ts\n│   ├── auth.ts\n│   └── permissions.ts\n│\n└── services/\n    ├── auth.service.ts\n    ├── event.service.ts\n    ├── registration.service.ts\n    └── user.service.ts",
