    {
      "id": "IAmms-nyNGzON_V2akSZz",
      "type": "text",
      "x": -478.27045967529295,
      "y": -1801.1939859281376,
      "width": 1291.893790108817,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "yB5wMyNOCEubJ91PvytEX",
      "index": "bOf",
      "roundness": null,
      "seed": 1440341098,
      "version": 832,
      "versionNonce": 1589131989,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687295,
      "created": 1789193271350,
      "link": null,
      "locked": false,
      "text": "Anyone can browse upcoming events and open an event-detail page. Each\nevent page shows the title, description, date and time, location, how\nmany spots are left, ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Anyone can browse upcoming events and open an event-detail page. Each event page shows the title, description, date and time, location, how many spots are left, ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "J8GNYpKVPvsjjFv8Emuf7",
      "type": "text",
      "x": -126.27042496100705,
      "y": -1711.193986213852,
      "width": 945.6080409458706,
      "height": 45,
      "angle": 0,
      "strokeColor": "#40c057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "yB5wMyNOCEubJ91PvytEX",
      "index": "bOg",
      "roundness": null,
      "seed": 739741171,
      "version": 1220,
      "versionNonce": 874334459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789339687295,
      "created": 1789281331749,
      "link": null,
      "locked": false,
      "text": " and whether the signed-in user is already registered.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " and whether the signed-in user is already registered.",
      "autoResize": false,
      "lineHeight": 1.25,
